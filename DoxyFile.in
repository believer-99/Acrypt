# Project settings
PROJECT_NAME     = HybridCryptoLib
PROJECT_BRIEF    = "A hybrid library for Searchable Encryption (SSE) and Fully Homomorphic Encryption (FHE)"
PROJECT_NUMBER   = 1.0
DOXYFILE_ENCODING= UTF-8
GENERATE_LATEX   = NO
GENERATE_RTF     = NO
GENERATE_MAN     = NO
GENERATE_XML     = NO
GENERATE_HTML    = YES
HTML_OUTPUT      = docs/html
HTML_EXTRA_STYLESHEET =
HTML_HEADER      =
HTML_FOOTER      =
HTML_NAVBAR      = YES
HTML_COLORSTYLE  = LIGHT

# Source code location
INPUT            = @PROJECT_SOURCE_DIR@/include \
                   @PROJECT_SOURCE_DIR@/src
FILE_PATTERNS    = *.h *.hpp *.cpp
RECURSIVE        = YES
EXCLUDE_PATTERNS = */tests/*

# Configuration
OPTIMIZE_OUTPUT_FOR_C = YES
EXTRACT_ALL      = YES
EXTRACT_PRIVATE  = YES